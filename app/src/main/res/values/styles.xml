<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- res/values/styles.xml -->
    <style name="AppPopupMenuStyle" parent="ThemeOverlay.AppCompat.Light">
        <item name="popupMenuStyle">@style/CustomPopupMenu</item>
    </style>

    <style name="CustomPopupMenu" parent="Widget.AppCompat.PopupMenu.Overflow">
        <item name="android:popupBackground">@color/blue</item>
        <item name="android:textColor">@android:color/white</item>
    </style>

    <style name="SpinnerBlack" parent="Widget.AppCompat.Spinner.Underlined">
        <item name="android:textColor">@android:color/black</item>
        <item name="android:backgroundTint">@android:color/black</item>
        <item name="android:popupBackground">@android:color/white</item> <!-- white background for contrast -->
    </style>

</resources>