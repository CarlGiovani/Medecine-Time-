<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Scrollable content -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:layout_above="@+id/fabContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Reminder Name + Switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/reminderLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Reminder Name"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/black"/>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/reminderSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>

            <!-- Dosage -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/dosageLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dosage"
                    android:layout_marginEnd="12dp"/>

                <EditText
                    android:id="@+id/dosageInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="number"
                    android:hint="e.g. 500"/>
            </LinearLayout>

            <!-- Dosage Type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/dosageTypeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dosage Type"
                    android:layout_marginEnd="12dp"/>

                <Spinner
                    android:id="@+id/dosageTypeSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <!-- Reminder Type -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp">

                <TextView
                    android:id="@+id/reminderTypeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Reminder Type"
                    android:layout_marginEnd="12dp"/>

                <Spinner
                    android:id="@+id/reminderTypeSpinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"/>
            </LinearLayout>

            <!-- Every X (hidden by default) -->
            <LinearLayout
                android:id="@+id/everyXRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/everyXLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Every"
                    android:layout_marginEnd="12dp"/>

                <Spinner
                    android:id="@+id/everyXSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="hour(s)"/>
            </LinearLayout>

            <!-- Time Picker -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp">

                <TextView
                    android:id="@+id/timeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Time"
                    android:layout_marginEnd="12dp"/>

                <TimePicker
                    android:id="@+id/timePicker"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:timePickerMode="spinner"/>
            </LinearLayout>

            <!-- Note -->
            <TextView
                android:id="@+id/noteLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Note"
                android:layout_marginTop="12dp"/>
            <EditText
                android:id="@+id/noteInput"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Optional note..."
                android:inputType="textMultiLine"
                android:gravity="top"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </ScrollView>

    <!-- Floating action buttons at the bottom (Save + Delete) -->
    <RelativeLayout
        android:id="@+id/fabContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="16dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/deleteReminderFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="#D32F2F"
            app:srcCompat="@android:drawable/ic_menu_delete"
            android:contentDescription="Delete"
            android:layout_alignParentStart="true"/>

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/saveReminderFab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="#1976D2"
            app:srcCompat="@android:drawable/ic_menu_save"
            android:contentDescription="Save"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

</RelativeLayout>
